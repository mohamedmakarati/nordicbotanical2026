{
  "name": "NurseryInquiry",
  "type": "object",
  "properties": {
    "nursery_id": {
      "type": "string"
    },
    "nursery_name": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "read",
        "replied"
      ],
      "default": "new"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "nursery_id",
    "sender_name",
    "sender_email",
    "message"
  ]
}