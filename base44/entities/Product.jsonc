{
  "name": "Product",
  "type": "object",
  "properties": {
    "plant_id": {
      "type": "string",
      "description": "Reference to Plant entity id"
    },
    "seller_id": {
      "type": "string",
      "description": "Reference to Seller entity id"
    },
    "product_title": {
      "type": "string",
      "description": "Product listing title as shown on seller site"
    },
    "price": {
      "type": "number",
      "description": "Current sale price (excluding shipping)"
    },
    "regular_price": {
      "type": "number",
      "description": "Original/regular price before discount (if on sale)"
    },
    "currency": {
      "type": "string",
      "enum": [
        "SEK",
        "NOK",
        "DKK",
        "EUR",
        "GBP"
      ],
      "default": "SEK",
      "description": "Price currency"
    },
    "shipping_cost": {
      "type": "number",
      "description": "Shipping cost (0 if free)"
    },
    "total_price": {
      "type": "number",
      "description": "Price + shipping cost"
    },
    "product_url": {
      "type": "string",
      "description": "Direct URL to the product page"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "availability": {
      "type": "string",
      "enum": [
        "in_stock",
        "out_of_stock",
        "limited",
        "pre_order"
      ],
      "default": "in_stock",
      "description": "Current stock status"
    },
    "pot_size": {
      "type": "string",
      "enum": [
        "6cm",
        "9cm",
        "12cm",
        "14cm",
        "17cm",
        "19cm",
        "21cm",
        "24cm",
        "27cm",
        "30cm+"
      ],
      "description": "Pot diameter"
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "When this product was last scraped/updated"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "product_title",
    "price",
    "currency",
    "product_url",
    "seller_id"
  ]
}