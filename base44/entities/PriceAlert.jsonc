{
  "name": "PriceAlert",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email to notify"
    },
    "product_id": {
      "type": "string",
      "description": "Reference to Product entity id"
    },
    "target_price": {
      "type": "number",
      "description": "Alert when price drops to or below this"
    },
    "plant_name": {
      "type": "string",
      "description": "Plant name for display"
    },
    "current_price": {
      "type": "number",
      "description": "Price at time of alert creation"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "triggered": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "email",
    "product_id",
    "target_price"
  ]
}