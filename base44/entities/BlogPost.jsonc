{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string"
    },
    "metaDescription": {
      "type": "string"
    },
    "keywordFocus": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "publishDate": {
      "type": "string",
      "format": "date"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug"
  ]
}