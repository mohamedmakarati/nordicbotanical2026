{
  "name": "ScraperLog",
  "type": "object",
  "properties": {
    "run_type": {
      "type": "string",
      "enum": [
        "manual",
        "daily",
        "weekly",
        "monthly"
      ],
      "description": "What triggered this run"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running"
    },
    "products_checked": {
      "type": "number",
      "default": 0
    },
    "products_updated": {
      "type": "number",
      "default": 0
    },
    "products_failed": {
      "type": "number",
      "default": 0
    },
    "robots_skipped": {
      "type": "number",
      "default": 0
    },
    "duplicates_detected": {
      "type": "number",
      "default": 0
    },
    "plants_matched": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "string",
      "description": "JSON string of detailed results"
    }
  },
  "required": [
    "run_type",
    "status"
  ]
}