{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bid_placed",
        "outbid",
        "auction_won",
        "auction_ended",
        "order_placed",
        "order_shipped",
        "price_alert",
        "new_message",
        "seller_approved",
        "listing_approved",
        "review_received"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "related_id": {
      "type": "string",
      "description": "Auction/order/product id"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "type",
    "title",
    "message"
  ]
}